{
  "common": {
    "name": "assistant-satellite",
    "version": "0.0.2",
    "title": "Assistant Satellite",
    "news": {
      "0.0.2": {
        "en": "Initial commit",
        "de": "Erster Commit",
        "ru": "Первоначальный коммит",
        "pt": "Confirmação inicial",
        "nl": "Eerste commit",
        "fr": "Engagement initial",
        "it": "Inizial impegnato",
        "es": "Compromiso inicial",
        "pl": "Początkowe zatwierdzenie",
        "uk": "Початковий коміт",
        "zh-cn": "初始提交"
      }
    },
    "titleLang": {
      "en": "Assistant Satellite",
      "de": "Assistent-Satellit",
      "ru": "Сателлит ассистента"
    },
    "desc": {
      "en": "Voice satellite for ioBroker.assistant: wake word + microphone streaming + spoken reply, running on this host.",
      "de": "Sprach-Satellit für ioBroker.assistant: Wake-Word + Mikrofon-Streaming + gesprochene Antwort, läuft auf diesem Host.",
      "ru": "Голосовой сателлит для ioBroker.assistant: слово-активатор, стриминг микрофона и озвученный ответ на этом хосте."
    },
    "authors": [
      "ioBroker"
    ],
    "licenseInformation": {
      "license": "MIT",
      "type": "free"
    },
    "tier": 3,
    "keywords": [
      "assistant",
      "voice",
      "satellite",
      "wakeword"
    ],
    "platform": "Javascript/Node.js",
    "main": "build/main.js",
    "icon": "assistant-satellite.svg",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/ioBroker/ioBroker.assistant-satellite/main/admin/assistant-satellite.svg",
    "readme": "https://github.com/ioBroker/ioBroker.assistant-satellite/blob/main/README.md",
    "loglevel": "info",
    "mode": "daemon",
    "nogit": true,
    "type": "communication",
    "compact": false,
    "connectionType": "local",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "osDependencies": {
      "linux": [
        "alsa-utils"
      ]
    },
    "messagebox": true
  },
  "native": {
    "assistantInstance": "",
    "transport": "ioBroker",
    "hostOverride": "",
    "room": "",
    "port": 7776,
    "audioBackend": "auto",
    "micDevice": "default",
    "speakerDevice": "default",
    "wakewordModel": "hey_jarvis",
    "wakewordModel2": "",
    "wakewordModel3": "",
    "wakewordThreshold": 0.5,
    "silenceThreshold": 300,
    "silenceMs": 800,
    "minRecordMs": 800,
    "maxRecordMs": 8000,
    "preBufferChunks": 5
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": "Satellite registered with the adapter",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "status",
      "type": "state",
      "common": {
        "name": "Satellite status (idle/listening/processing/speaking)",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": "idle"
      },
      "native": {}
    },
    {
      "_id": "test",
      "type": "channel",
      "common": { "name": "Wake-word test" },
      "native": {}
    },
    {
      "_id": "test.peakScore",
      "type": "state",
      "common": {
        "name": "Peak wake-word score during the last test",
        "type": "number",
        "role": "value",
        "min": 0,
        "max": 1,
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "test.detected",
      "type": "state",
      "common": {
        "name": "Wake word detected during the last test",
        "type": "boolean",
        "role": "indicator",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "test.score",
      "type": "state",
      "common": {
        "name": "Live wake-word score during the test",
        "type": "number",
        "role": "value",
        "min": 0,
        "max": 1,
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "test.micLevel",
      "type": "state",
      "common": {
        "name": "Live microphone level (RMS) during the test",
        "type": "number",
        "role": "value",
        "min": 0,
        "max": 32768,
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "test.running",
      "type": "state",
      "common": {
        "name": "Wake-word test is running",
        "type": "boolean",
        "role": "indicator",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}

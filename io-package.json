        "authors": ["ioBroker"],
        "licenseInformation": {
            "license": "MIT",
            "type": "free"
        },
        "tier": 3,
        "keywords": ["assistant", "voice", "satellite", "wakeword"],
        "platform": "Javascript/Node.js",
        "main": "build/main.js",
        "icon": "assistant-satellite.svg",
        "enabled": true,
        "extIcon": "https://raw.githubusercontent.com/ioBroker/ioBroker.assistant-satellite/main/admin/assistant-satellite.svg",
        "readme": "https://github.com/ioBroker/ioBroker.assistant-satellite/blob/main/README.md",
        "loglevel": "info",
        "mode": "daemon",
        "nogit": true,
        "type": "communication",
        "compact": false,
        "connectionType": "local",
        "dataSource": "push",
        "adminUI": {
            "config": "json"
        },
        "dependencies": [
            {
                "js-controller": ">=6.0.11"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=8.0.0"
            }
        ],
        "osDependencies": {
            "linux": ["alsa-utils"]
        },
        "messagebox": true
    },
    "native": {
        "assistantInstance": "",
        "transport": "ioBroker",
        "hostOverride": "",
        "room": "",
        "port": 7776,
        "audioBackend": "auto",
        "micDevice": "default",
        "speakerDevice": "default",
        "mixerControl": "",
        "wakewordModel": "hey_jarvis",
        "wakewordModel2": "",
        "wakewordModel3": "",
        "wakewordUpload": "",
        "followUp": false,
        "followUpSeconds": 6,
        "wakewordThreshold": 0.5,
        "silenceThreshold": 300,
        "silenceMs": 800,
        "minRecordMs": 800,
        "maxRecordMs": 8000,
        "preBufferChunks": 5
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "",
            "type": "meta",
            "common": {
                "name": "Uploaded wake-word models",
                "type": "meta.user"
            },
            "native": {}
        },
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "name": "Satellite registered with the adapter",
                "type": "boolean",
                "role": "indicator.connected",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "status",
            "type": "state",
            "common": {
                "name": "Satellite status (idle/listening/processing/speaking)",
                "type": "string",
                "role": "text",
                "read": true,
                "write": false,
                "def": "idle"
            },
            "native": {}
        },
        {
            "_id": "volume",
            "type": "state",
            "common": {
                "name": "Speaker volume (0–100 %)",
                "type": "number",
                "role": "level.volume",
                "unit": "%",
                "min": 0,
                "max": 100,
                "read": true,
                "write": true,
                "def": 100
            },
            "native": {}
        },
        {
            "_id": "mute",
            "type": "state",
            "common": {
                "name": "Mute speaker",
                "type": "boolean",
                "role": "media.mute",
                "read": true,
                "write": true,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "dnd",
            "type": "state",
            "common": {
                "name": "Do not disturb (suppress announcements)",
                "type": "boolean",
                "role": "switch.enable",
                "read": true,
                "write": true,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "test",
            "type": "channel",
            "common": {
                "name": "Wake-word test"
            },
            "native": {}
        },
        {
            "_id": "test.peakScore",
            "type": "state",
            "common": {
                "name": "Peak wake-word score during the last test",
                "type": "number",
                "role": "value",
                "min": 0,
                "max": 1,
                "read": true,
                "write": false,
                "def": 0
            },
            "native": {}
        },
        {
            "_id": "test.detected",
            "type": "state",
            "common": {
                "name": "Wake word detected during the last test",
                "type": "boolean",
                "role": "indicator",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "test.score",
            "type": "state",
            "common": {
                "name": "Live wake-word score during the test",
                "type": "number",
                "role": "value",
                "min": 0,
                "max": 1,
                "read": true,
                "write": false,
                "def": 0
            },
            "native": {}
        },
        {
            "_id": "test.micLevel",
            "type": "state",
            "common": {
                "name": "Live microphone level (RMS) during the test",
                "type": "number",
                "role": "value",
                "min": 0,
                "max": 32768,
                "read": true,
                "write": false,
                "def": 0
            },
            "native": {}
        },
        {
            "_id": "test.running",
            "type": "state",
            "common": {
                "name": "Wake-word test is running",
                "type": "boolean",
                "role": "indicator",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        }
    ]
}

{
    "name": "iobroker.assistant-satellite",
    "version": "0.1.0",
    "description": "ioBroker adapter that runs a voice satellite for ioBroker.assistant on this host (wake word + mic streaming + TTS playback). Thin wrapper around @iobroker/assistant-satellite.",
    "author": "ioBroker",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "assistant",
        "voice",
        "satellite",
        "wakeword",
        "openwakeword"
    ],
    "main": "build/main.js",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "@iobroker/assistant-satellite": "^0.1.7"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^5.3.0",
        "@types/node": "^20.19.43",
        "typescript": "~6.0.3"
    },
    "scripts": {
        "build": "npm run build:backend && npm run build:gui",
        "build:backend": "tsc -p tsconfig.build.json",
        "build:gui": "cd src-admin && npm install && npm run build",
        "prepublishOnly": "npm run build",
        "test:integration": "echo \"no tests yet\" && exit 0",
        "test:package": "mocha test/testPackageFiles.ts --exit",
        "test": "echo \"no tests yet\" && exit 0",
        "lint": "eslint -c eslint.config.mjs",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes",
        "release": "release-script",
        "update-packages": "npx -y npm-check-updates --upgrade"
    },
    "files": [
        "admin/",
        "build/",
        "models/",
        "io-package.json",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ioBroker/ioBroker.assistant-satellite.git"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.assistant-satellite/issues"
    },
    "homepage": "https://github.com/ioBroker/ioBroker.assistant-satellite"
}

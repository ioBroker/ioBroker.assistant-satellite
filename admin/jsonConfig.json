{
    "i18n": true,
    "type": "panel",
    "items": {
        "_serverHeader": { "type": "header", "size": 2, "text": "ioBroker.assistant server" },
        "assistantInstance": {
            "newLine": true,
            "type": "instance",
            "adapter": "assistant",
            "label": "Assistant instance",
            "help": "The ioBroker.assistant instance this satellite talks to (needs the instance running).",
            "sm": 12,
            "md": 5
        },
        "transport": {
            "type": "select",
            "label": "Transport",
            "help": "ioBroker = audio over the message bus, no UDP port, STT/TTS central (recommended). UDP = Hannah audio stream (ESP-compatible).",
            "options": [
                { "label": "ioBroker (message bus, no UDP)", "value": "ioBroker" },
                { "label": "UDP (Hannah / ESP stream)", "value": "udp" }
            ],
            "default": "ioBroker",
            "sm": 12,
            "md": 4
        },
        "port": {
            "type": "number",
            "label": "Local listen port",
            "help": "UDP port this satellite receives TTS on.",
            "default": 7776,
            "min": 1,
            "max": 65535,
            "hidden": "data.transport === 'ioBroker'",
            "sm": 6,
            "md": 3
        },
        "hostOverride": {
            "newLine": true,
            "type": "text",
            "label": "Host IP override (optional)",
            "help": "Force a specific IP if the automatic resolution picks the wrong interface.",
            "hidden": "data.transport === 'ioBroker'",
            "sm": 12,
            "md": 4
        },

        "_idHeader": { "newLine": true, "type": "header", "size": 2, "text": "Identity" },
        "room": { "newLine": true, "type": "room", "label": "Room", "sm": 12, "md": 4 },
        "_audioHeader": { "newLine": true, "type": "header", "size": 2, "text": "Audio" },
        "audioBackend": {
            "newLine": true,
            "type": "select",
            "label": "Audio backend",
            "options": [
                { "label": "Auto", "value": "auto" },
                { "label": "ALSA (arecord/aplay)", "value": "alsa" },
                { "label": "ffmpeg", "value": "ffmpeg" }
            ],
            "default": "auto",
            "sm": 6,
            "md": 3
        },
        "micDevice": {
            "type": "autocompleteSendTo",
            "label": "Microphone device",
            "help": "ALSA e.g. plughw:2,0; ffmpeg = dshow name / avfoundation index. 'default' = system default. The list is read from this host (instance must be running).",
            "command": "getMicDevices",
            "jsonData": "{\"backend\": \"${data.audioBackend}\"}",
            "alsoDependsOn": ["audioBackend"],
            "freeSolo": true,
            "default": "default",
            "sm": 6,
            "md": 4
        },
        "speakerDevice": {
            "type": "autocompleteSendTo",
            "label": "Speaker device",
            "help": "'default' = system default. The list is read from this host (instance must be running).",
            "command": "getSpeakerDevices",
            "jsonData": "{\"backend\": \"${data.audioBackend}\"}",
            "alsoDependsOn": ["audioBackend"],
            "freeSolo": true,
            "default": "default",
            "sm": 6,
            "md": 4
        },
        "mixerControl": {
            "type": "text",
            "label": "ALSA mixer control (optional)",
            "help": "For the volume/mute states. Empty = auto-detect on the speaker's card. Set a name (e.g. PCM, Master, Speaker — see 'amixer -c <card> scontrols') if auto-detection picks the wrong one. ALSA only.",
            "hidden": "data.audioBackend === 'ffmpeg'",
            "sm": 6,
            "md": 4
        },
        "_wwHeader": { "newLine": true, "type": "header", "size": 2, "text": "Wake word" },
        "wakewordModel": {
            "newLine": true,
            "type": "autocompleteSendTo",
            "label": "Wake word model",
            "help": "Built-in: hey_jarvis, alexa, hey_mycroft, hey_rhasspy. Or a URL / local .onnx path.",
            "command": "getWakewords",
            "freeSolo": true,
            "default": "hey_jarvis",
            "sm": 6,
            "md": 4,
            "lg": 3
        },
        "wakewordModel2": {
            "type": "autocompleteSendTo",
            "label": "Wake word 2 (optional)",
            "help": "A second wake word — the satellite triggers on any of them.",
            "command": "getWakewords",
            "freeSolo": true,
            "hidden": "!data.wakewordModel",
            "sm": 6,
            "md": 4,
            "lg": 3
        },
        "wakewordModel3": {
            "type": "autocompleteSendTo",
            "label": "Wake word 3 (optional)",
            "help": "A third wake word.",
            "command": "getWakewords",
            "freeSolo": true,
            "hidden": "!data.wakewordModel || !data.wakewordModel2",
            "sm": 6,
            "md": 4,
            "lg": 3
        },
        "wakewordThreshold": {
            "type": "number",
            "label": "Threshold (0–1)",
            "help": "Lower = more sensitive.",
            "default": 0.5,
            "min": 0,
            "max": 1,
            "step": 0.05,
            "sm": 6,
            "md": 2,
            "lg": 3
        },
        "wakewordUpload": {
            "newLine": true,
            "type": "fileSelector",
            "objectID": "assistant-satellite.%INSTANCE%",
            "pattern": "wakeWords/*.onnx",
            "upload": "wakeWords/",
            "maxSize": 10485760,
            "delete": true,
            "label": "Upload a custom wake-word model (.onnx)",
            "help": "Upload a single self-contained .onnx here, then pick it in a 'Wake word' field above (needs the instance running). External-data models (.onnx + .onnx.data) are not supported — export a single file.",
            "sm": 12,
            "md": 6
        },
        "followUp": {
            "newLine": true,
            "type": "checkbox",
            "label": "Follow-up conversation (no wake word for replies)",
            "help": "After the assistant answers, keep the mic open briefly so you can continue ('…and the kitchen too') or answer a clarifying question without saying the wake word again. Falls back to wake-word mode after silence.",
            "default": false,
            "sm": 8,
            "md": 5
        },
        "followUpSeconds": {
            "type": "number",
            "label": "Follow-up window (s)",
            "help": "How long to wait for you to continue before returning to wake-word mode.",
            "default": 6,
            "min": 1,
            "max": 30,
            "hidden": "!data.followUp",
            "sm": 4,
            "md": 3
        },
        "_wakeTest": {
            "newLine": true,
            "type": "custom",
            "i18n": true,
            "url": "custom/customComponents.js",
            "name": "ConfigCustomAssistantSatellite/Components/WakeWordTestComponent",
            "bundlerType": "module",
            "sm": 12
        },
        "_recHeader": { "newLine": true, "type": "header", "size": 3, "text": "Recording (advanced)" },
        "silenceThreshold": {
            "newLine": true,
            "type": "number",
            "label": "Silence RMS threshold",
            "default": 300,
            "sm": 6,
            "md": 2
        },
        "silenceMs": { "type": "number", "label": "Silence (ms)", "default": 800, "sm": 6, "md": 2 },
        "minRecordMs": { "type": "number", "label": "Min record (ms)", "default": 800, "sm": 6, "md": 2 },
        "maxRecordMs": { "type": "number", "label": "Max record (ms)", "default": 8000, "sm": 6, "md": 2 },
        "preBufferChunks": { "type": "number", "label": "Pre-buffer chunks", "default": 5, "sm": 6, "md": 2 }
    }
}
